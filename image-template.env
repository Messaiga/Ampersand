# Here we set a bunch of parameters for your image build

# output image name for the standard variant; CI also builds "${IMAGE_NAME}-dx"
IMAGE_NAME=ampersand

# Make this the same as your github username/organisation
REPO_ORGANIZATION="Messaiga"

IMAGE_DESC="Ampersand: an opinionated custom image of Project Bluefin"
IMAGE_KEYWORDS="bootc,oci,linux,bluefin,gnome"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="stable"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"

# Upstream base image for the standard variant (the DX variant uses "${BASE_IMAGE}-dx")
BASE_IMAGE="ghcr.io/ublue-os/bluefin"
BASE_TAG="stable"
