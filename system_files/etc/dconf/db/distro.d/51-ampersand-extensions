[org/gnome/shell/extensions/simple-taskbar/dock]
active-dock-axis='horizontal'
dock-autohide-enabled=true
dock-axis-profiles-initialized=true
dock-dodge-windows-enabled=false
dock-horizontal-settings={'dock-axis-profile-version': <uint32 1>, 'icon-size': <48>, 'use-pinned-apps-as-launchers': <false>, 'show-pinned-app-separator': <true>, 'icon-spacing': <6>, 'gnome-start-button-visible': <true>, 'combine-app-buttons-mode': <'always'>, 'start-button-padding': <2>, 'windows-start-menu-enabled': <false>}
