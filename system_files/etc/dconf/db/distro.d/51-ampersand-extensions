# Ampersand's extension settings (Ryan's tuned setup, from `dconf dump /`).
# Same format as `dconf dump`: to change one, set it up on a machine, run
# `dconf dump /org/gnome/shell/extensions/<name>/`, and paste the keys here.
# Leave out runtime state (window sizes, device names, "initialized" flags that
# an extension sets for itself). Files here are read in order, so this one wins
# over Bluefin's 0N-bluefin-* files. `ujust reset-desktop` resets every key.

[org/gnome/shell/extensions/simple-taskbar]
active-panel-axis='horizontal'
active-panel-mode='default-panel'
clock-position='center'
combine-app-buttons-mode='always'
default-gnome-panel=true
gnome-start-button-visible=false
hide-dash-enabled=false
hide-pinned-taskbar-apps=false
hide-unpinned-taskbar-apps=false
icon-size=48
icon-spacing=6
launch-to-desktop-enabled=false
locations-show-downloads=false
locations-show-network=true
panel-axis-profiles-initialized=true
panel-button-padding=12
panel-height=32
panel-mode-profiles-initialized=true
panel-position='top'
show-desktop-button-visible=false
show-pinned-app-separator=true
start-button-padding=2
taskbar-horizontal-settings={'hide-pinned-taskbar-apps': <false>, 'activities-button-position': <'left'>, 'tray-overflow-position': <'right'>, 'panel-item-order': <['activities', 'center-box', 'tray-overflow', 'start-button', 'left-box', 'applications', 'right-box', 'folder-menu', 'system-menu', 'clock', 'show-desktop']>, 'gnome-start-button-visible': <false>, 'show-desktop-button-visible': <false>, 'target-prefs-page': <''>, 'tray-overflow-enabled': <true>, 'activities-button-visible': <true>, 'windows-start-menu-enabled': <false>, 'hide-unpinned-taskbar-apps': <false>}
taskbar-horizontal-settings-saved=true
taskbar-mode-settings={'hide-pinned-taskbar-apps': <false>, 'activities-button-position': <'left'>, 'tray-overflow-position': <'right'>, 'panel-item-order': <['activities', 'center-box', 'tray-overflow', 'start-button', 'left-box', 'applications', 'right-box', 'folder-menu', 'system-menu', 'clock', 'show-desktop']>, 'gnome-start-button-visible': <false>, 'show-desktop-button-visible': <false>, 'target-prefs-page': <''>, 'tray-overflow-enabled': <true>, 'activities-button-visible': <true>, 'windows-start-menu-enabled': <false>, 'hide-unpinned-taskbar-apps': <false>}
taskbar-mode-settings-saved=true
use-pinned-apps-as-launchers=false
windows-10-theme-enabled=false
windows-start-menu-enabled=false
windows-xp-theme-enabled=false

[org/gnome/shell/extensions/simple-taskbar/default-panel]
default-panel-horizontal-settings={'launch-to-desktop-enabled': <false>, 'panel-height': <32>, 'hide-dash-enabled': <false>, 'gnome-start-button-visible': <false>, 'show-desktop-button-visible': <false>, 'panel-button-padding': <12>, 'clock-position': <'center'>, 'windows-start-menu-enabled': <false>}
