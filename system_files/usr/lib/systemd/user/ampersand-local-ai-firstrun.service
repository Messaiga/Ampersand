[Unit]
Description=Set up Ampersand's local AI assistant once (ujust ampersand-local-ai)
After=graphical-session.target
# Not for the login screen's own session (GDM runs as a system user).
ConditionUser=!@system
# Created by the recipe when setup finishes, or when the user undoes it.
ConditionPathExists=!%h/.local/state/ampersand/local-ai-done

[Service]
Type=oneshot
ExecStart=/usr/bin/ujust ampersand-local-ai auto

[Install]
WantedBy=graphical-session.target
