# Ampersand's GNOME defaults. Loaded after Bluefin's zz0-bluefin-modifications,
# so a key set here replaces Bluefin's value. Only defaults: anything a user has
# changed keeps their value (`ujust ampersand-gnome` resets to these).
# Custom keyboard shortcuts live in /etc/dconf/db/distro.d/50-ampersand-keybindings.

[org.gnome.shell]
# Bluefin's list without Dash to Dock and Custom Command List, plus Ampersand's.
enabled-extensions=['appindicatorsupport@rgcjonas.gmail.com', 'bazaar-integration@kolunmi.github.io', 'blur-my-shell@aunetx', 'caffeine@patapon.info', 'gradia-integration@alexandervanhee.github.io', 'gsconnect@andyholmes.github.io', 'logomenu@aryan_k', 'search-light@icedman.github.com', 'AlphabeticalAppGrid@stuarthayhurst', 'app-grid-wizard@mirzadeh.pro', 'auto-accent-colour@Wartybix', 'gtk4-ding@smedius.gitlab.com', 'just-perfection-desktop@just-perfection', 'pipewire-settings@gaheldev.github.com', 'quick-settings-audio-panel@rayzeq.github.io', 'quicksettings-audio-devices-hider@marcinjahn.com', 'quicksettings-audio-devices-renamer@marcinjahn.com', 'simple-taskbar@sultech', 'tailscale-gnome@diskmth.fr', 'tilingshell@ferrarodomenico.com', 'user-accent-colors@fabito02', 'wiggly@mojarch']
# Bluefin's pins without Thunderbird, plus Whisp and Deep Dive.
favorite-apps=['org.mozilla.firefox.desktop', 'org.gnome.Nautilus.desktop', 'io.github.kolunmi.Bazaar.desktop', 'org.gnome.Software.desktop', 'code.desktop', 'io.github.tanaybhomia.Whisp.desktop', 'io.github.tanaybhomia.DeepDive.desktop']

[org.gnome.desktop.interface]
enable-hot-corners=false
color-scheme='default'
icon-theme='Hatter-Slate'

[org.gnome.desktop.sound]
allow-volume-above-100-percent=false

[org.gnome.mutter]
workspaces-only-on-primary=true

# Never suspend on AC power, never dim or blank the screen (so no idle lock either).
[org.gnome.settings-daemon.plugins.power]
sleep-inactive-ac-type='nothing'
idle-dim=false

[org.gnome.desktop.session]
idle-delay=uint32 0

# Leader key (keyd sends Ctrl+Alt+Super+letter): built-in launchers.
[org.gnome.settings-daemon.plugins.media-keys]
www=['<Control><Alt><Super>b']
calculator=['<Control><Alt><Super>c']
control-center=['<Control><Alt><Super>i']
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom2/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/ampersand-terminal/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/ampersand-whisp/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/ampersand-deepdive/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/ampersand-dictation/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/ampersand-newelle/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/ampersand-phone/']

#-------------- Extensions --------------#

# Alt+Tab shows only the windows on the monitor it is opened on.
[org.gnome.shell.extensions.simple-taskbar]
grid-alt-tab-isolate-monitors=true

# Folder colours come from Hatter (ampersand-icon-accent), not ChromaLeon.
[org.gnome.shell.extensions.chromaleon]
recolor-folders=false
