# Optional audio bundle: ujust ampersand-audio (enable or disable)
flatpak "com.bitwig.BitwigStudio"
flatpak "fm.reaper.Reaper"
flatpak "org.ardour.Ardour"
flatpak "io.lmms.LMMS"
flatpak "org.zrythm.Zrythm"
flatpak "org.hydrogenmusic.Hydrogen"
flatpak "org.musescore.MuseScore"
flatpak "org.pipewire.Helvum"
flatpak "org.tildearrow.furnace"
flatpak "io.github.revisto.drum-machine"
flatpak "com.adrienplazas.Metronome"
# Mixtapes is not on Flathub; this adds its own "mixtapes" remote first.
flatpak "com.pocoguy.Muse", remote: "mixtapes", url: "https://m-obeid.github.io/Mixtapes/mixtapes.flatpakrepo"
