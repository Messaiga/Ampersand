# Flatpak applications installed on first boot.
#
# Format: an INI file read by `flatpak preinstall`, one section per app:
#
#   [Flatpak Preinstall APP_ID]
#   Branch=stable
#
# Comments must start with '#'; the parser is GKeyFile, so a ';' line is a
# syntax error, and flatpak discards the entire file when one line is malformed.
# See: https://docs.flatpak.org/en/latest/flatpak-command-reference.html#flatpak-preinstall
#
# Every app here is on Flathub, and `just validate-flatpaks` checks each one
# before a change can land. Opt-in app groups are Brewfiles in custom/brew/,
# installed with ujust; spec/flatpaks.md records what is here and why.

# GNOME core apps.
[Flatpak Preinstall org.gnome.Calculator]
Branch=stable
[Flatpak Preinstall org.gnome.Calendar]
Branch=stable
[Flatpak Preinstall org.gnome.Snapshot]
Branch=stable
