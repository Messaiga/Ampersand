[Flatpak Preinstall org.gnome.Firmware]
Branch=stable
[Flatpak Preinstall org.gnome.font-viewer]
Branch=stable
[Flatpak Preinstall org.gnome.Loupe]
Branch=stable
[Flatpak Preinstall org.gnome.Logs]
Branch=stable
[Flatpak Preinstall org.gnome.Maps]
