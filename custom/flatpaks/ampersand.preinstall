# Ampersand default Flatpaks, installed automatically at boot by
# flatpak-preinstall.service (Flatpak's own mechanism; Bluefin uses it for Bazaar).
# An app the user uninstalls is not reinstalled. Careful: removing an entry
# here UNINSTALLS that app from every machine on its next boot.
# Source of truth for the choices: spec/04 and notes/wishlist.md.

[Flatpak Preinstall be.alexandervanhee.gradia]
Branch=stable
IsRuntime=false

