# ujust audio-apps (see README.md for the format).
flatpak "org.ardour.Ardour" # Ardour: DAW (recommended)
flatpak "io.lmms.LMMS" # LMMS: beat-making DAW (recommended)
flatpak "org.hydrogenmusic.Hydrogen" # Hydrogen: drum machine (recommended)
flatpak "org.musescore.MuseScore" # MuseScore: sheet music (recommended)
flatpak "org.pipewire.Helvum" # Helvum: PipeWire patchbay (recommended)
flatpak "com.adrienplazas.Metronome" # Metronome: metronome (recommended)
flatpak "com.bitwig.BitwigStudio" # Bitwig Studio: DAW (Flathub build)
flatpak "fm.reaper.Reaper" # Reaper: DAW
flatpak "org.zrythm.Zrythm" # Zrythm: DAW
flatpak "org.tildearrow.furnace" # Furnace: chiptune tracker
flatpak "io.github.revisto.drum-machine" # Drum Machine: simple drum sequencer
# Mixtapes is not on Flathub; this adds its own "mixtapes" remote first.
flatpak "com.pocoguy.Muse", remote: "mixtapes", url: "https://m-obeid.github.io/Mixtapes/mixtapes.flatpakrepo" # Mixtapes: music player
