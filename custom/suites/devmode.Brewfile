# ujust devmode: developer tools (see README.md for the format).
tap "ublue-os/tap", trusted: true

# IDEs and editors
cask "ublue-os/tap/visual-studio-code-linux" # VS Code: main IDE with Ampersand's five profiles (recommended)
cask "ublue-os/tap/vscodium-linux" # VSCodium: VS Code without Microsoft telemetry
cask "zed" # Zed: fast native editor
cask "ublue-os/tap/jetbrains-toolbox-linux" # JetBrains Toolbox: installs and updates JetBrains IDEs
brew "nvim" # Neovim: terminal editor
brew "helix" # Helix: terminal editor
brew "vim" # vim: terminal editor
brew "micro" # micro: simple terminal editor

# Containers (Podman is the engine; the Docker CLI talks to it)
brew "devcontainer" # devcontainer CLI: runs VS Code dev containers from the terminal (recommended)
brew "docker" # Docker CLI: docker commands run by Podman (recommended)
brew "docker-compose" # Docker Compose: multi-container apps (recommended)
brew "lazydocker" # lazydocker: terminal UI for containers
brew "dive" # dive: inspects image layers
brew "hadolint" # hadolint: Containerfile linter used by the VS Code extension (recommended)
flatpak "io.podman_desktop.PodmanDesktop" # Podman Desktop: container GUI (recommended)
flatpak "com.github.marhkb.Pods" # Pods: lighter GNOME container app
brew "lima" # Lima: Ubuntu VM like WSL (then run ujust setup-lima)

# Developer apps
flatpak "io.github.getnf.embellish" # Embellish: installs Nerd Fonts (recommended)
flatpak "me.iepure.devtoolbox" # Dev Toolbox: encoders and formatters and converters (recommended)
flatpak "de.leopoldluley.Clapgrep" # Clapgrep: search inside files
flatpak "org.gnome.Builder" # GNOME Builder: GNOME's IDE
flatpak "org.flatpak.Builder" # Flatpak Builder: builds Flatpaks
flatpak "org.freedesktop.Bustle" # Bustle: D-Bus traffic viewer
flatpak "org.gnome.dspy" # D-Spy: D-Bus explorer
flatpak "org.fedoraproject.MediaWriter" # Fedora Media Writer: writes ISOs to USB sticks
