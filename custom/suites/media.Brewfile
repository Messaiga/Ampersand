# ujust media-apps (see README.md for the format).
flatpak "com.obsproject.Studio" # OBS Studio: recording and streaming (recommended)
flatpak "org.kde.kdenlive" # Kdenlive: video editor (recommended)
flatpak "org.videolan.VLC" # VLC: plays anything (recommended)
flatpak "fr.natron.Natron" # Natron: compositing
flatpak "tv.kodi.Kodi" # Kodi: media center
flatpak "com.stremio.Stremio" # Stremio: streaming hub
flatpak "com.github.huluti.Curtail" # Curtail: image compressor
flatpak "io.gitlab.adhami3310.Converter" # Switcheroo: image converter
flatpak "io.gitlab.theevilskeleton.Upscaler" # Upscaler: AI image upscaling
