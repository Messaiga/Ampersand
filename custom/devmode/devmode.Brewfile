# Everything `ujust devmode` installs (all of it, no picking). Bluefin's
# Developer Mode list, plus the Flatpaks and CLI tools ampersand-dx used to ship.
# Edit this list to change what developer mode installs.

tap "ublue-os/tap", trusted: true

# Dev containers and containers
brew "devcontainer"
brew "docker"
brew "docker-compose"
brew "lazydocker"
brew "dive"
brew "hadolint"
flatpak "io.podman_desktop.PodmanDesktop"
flatpak "com.github.marhkb.Pods"

# Lightweight Linux VM (create the Ubuntu VM with: ujust setup-lima)
brew "lima"

# IDEs
cask "ublue-os/tap/visual-studio-code-linux"
cask "ublue-os/tap/vscodium-linux"
cask "ublue-os/tap/antigravity-linux"
cask "zed"
cask "ublue-os/tap/jetbrains-toolbox-linux"

# Terminal editors
brew "nvim"
brew "helix"
brew "vim"
brew "micro"

# Developer apps (were the ampersand-dx Flatpaks)
flatpak "de.leopoldluley.Clapgrep"
flatpak "io.github.getnf.embellish"
flatpak "me.iepure.devtoolbox"
flatpak "org.gnome.Builder"
flatpak "org.nickvision.money"
flatpak "org.flatpak.Builder"
flatpak "org.freedesktop.Bustle"
flatpak "org.gnome.dspy"
flatpak "org.fedoraproject.MediaWriter"
