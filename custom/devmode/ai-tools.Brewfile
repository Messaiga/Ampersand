# The menu `ujust ampersand-ai-tools` offers (nothing is installed by default).
# Bluefin's AI tools list plus Claude Desktop. Each entry's comment is its label
# in the menu; keep labels free of commas.

tap "anomalyco/tap"
tap "charmbracelet/tap"
tap "llmmanorg/tap"
tap "ublue-os/tap", trusted: true
tap "ublue-os/experimental-tap", trusted: true

# Desktop apps
cask "ublue-os/experimental-tap/claude-desktop-linux" # Claude Desktop: Anthropic's Claude app
cask "ublue-os/tap/goose-linux" # Goose Desktop: AI agent app (MCP tools)
cask "ublue-os/experimental-tap/opencode-desktop-linux" # OpenCode Desktop: coding agent app
cask "ublue-os/tap/antigravity-linux" # Antigravity: Google's agent IDE
cask "ublue-os/tap/lm-studio-linux" # LM Studio: run and chat with local models (second model runner)
flatpak "ai.jan.Jan" # Jan: run and chat with local models (second model runner)

# Coding agents in the terminal
cask "claude-code" # Claude Code: Anthropic's coding agent
cask "codex" # Codex CLI: OpenAI's coding agent
cask "copilot-cli" # Copilot CLI: GitHub's coding agent
cask "antigravity-cli" # Antigravity CLI
brew "block-goose-cli" # Goose CLI
brew "anomalyco/tap/opencode-v2" # OpenCode CLI
brew "charmbracelet/tap/crush" # Crush: Charm's coding agent
brew "kimi-code" # Kimi Code
brew "mistral-vibe" # Mistral Vibe
brew "qwen-code" # Qwen Code

# Helpers
brew "llm" # llm: run prompts from the terminal
brew "llmfit" # llmfit: which local models fit this machine
brew "llmmanorg/tap/llmman" # llmman: manage local models
brew "ublue-os/tap/linux-mcp-server" # Linux MCP server: read-only system diagnostics for agents
