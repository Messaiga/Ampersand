# Audio, video and music production: ujust install-media-production
# Installed system-wide by `brew bundle` (flatpak install --system flathub).

# Video and compositing
flatpak "org.kde.kdenlive"
flatpak "com.obsproject.Studio"
flatpak "fr.natron.Natron"

# Audio routing
flatpak "org.rncbc.qpwgraph"

# Music
flatpak "fm.reaper.Reaper"
flatpak "io.lmms.LMMS"
flatpak "org.musescore.MuseScore"
flatpak "io.github.revisto.drum-machine"
flatpak "com.adrienplazas.Metronome"
