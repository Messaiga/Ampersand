# Developer desktop apps: ujust install-dev-apps
# Bluefin's developer experience apps are a separate group, shipped unchanged
# from upstream: ujust install-dx-apps.
# Installed system-wide by `brew bundle` (flatpak install --system flathub).

flatpak "org.freedesktop.Bustle"
flatpak "org.gnome.dspy"
flatpak "com.github.marhkb.Pods"
flatpak "org.flatpak.Builder"
flatpak "io.github.ronniedroid.concessio"
