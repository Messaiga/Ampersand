# ujust ai-tools: AI apps and coding agents (see README.md for the format).
# Bluefin's AI tools list plus Claude Desktop. Newelle (the local assistant) is
# a default app; ujust toggle-local-ai sets up its local model.
tap "anomalyco/tap", trusted: true
tap "llmmanorg/tap", trusted: true
tap "ublue-os/tap", trusted: true
tap "ublue-os/experimental-tap", trusted: true

# Desktop apps
cask "ublue-os/experimental-tap/claude-desktop-linux" # Claude Desktop: Anthropic's Claude app (recommended)
cask "ublue-os/tap/goose-linux" # Goose Desktop: AI agent app with MCP tools (recommended)
cask "ublue-os/tap/antigravity-linux" # Antigravity: Google's agent IDE (recommended)
cask "ublue-os/experimental-tap/opencode-desktop-linux" # OpenCode Desktop: coding agent app
cask "ublue-os/tap/lm-studio-linux" # LM Studio: runs and chats with local models
flatpak "ai.jan.Jan" # Jan: runs and chats with local models

# Coding agents in the terminal
cask "claude-code" # Claude Code: Anthropic's coding agent (recommended)
cask "antigravity-cli" # Antigravity CLI: Google's coding agent (recommended)
brew "block-goose-cli" # Goose CLI: Goose in the terminal (recommended)
cask "codex" # Codex CLI: OpenAI's coding agent
cask "copilot-cli" # Copilot CLI: GitHub's coding agent
brew "anomalyco/tap/opencode-v2" # OpenCode CLI: OpenCode in the terminal
# Crush (charmbracelet/tap/crush) is left out until that tap loads: trusting it
# makes brew evaluate every formula in it, and its tone.rb is invalid (2026-10-30).
brew "kimi-code" # Kimi Code: Moonshot's coding agent
brew "mistral-vibe" # Mistral Vibe: Mistral's coding agent
brew "qwen-code" # Qwen Code: Alibaba's coding agent

# Helpers
brew "ublue-os/tap/linux-mcp-server" # Linux MCP server: read-only system diagnostics for agents (recommended)
brew "llm" # llm: run prompts from the terminal
brew "llmfit" # llmfit: shows which local models fit this machine
brew "llmmanorg/tap/llmman" # llmman: manages local models
