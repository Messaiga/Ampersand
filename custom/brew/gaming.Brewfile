# ujust gaming-apps (see README.md for the format).
flatpak "com.valvesoftware.Steam" # Steam: game store and launcher (recommended)
flatpak "com.usebottles.bottles" # Bottles: runs Windows apps and games (recommended)
flatpak "net.lutris.Lutris" # Lutris: game launcher for every store and emulator (recommended)
flatpak "com.vysp3r.ProtonPlus" # ProtonPlus: manages Proton and Wine versions (recommended)
