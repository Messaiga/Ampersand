{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  // Version pins in build scripts, marked with a "# renovate:" comment line,
  // e.g. the icon theme tags in build_files/30-icons.sh.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^build_files/.+\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+=(?<currentValue>\\S+)"
      ]
    }
  ],

  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    // Ampersand follows upstream Bluefin's moving "stable" tag on purpose
    // (weekly rebuilds pick up new releases), so never pin it to a digest.
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ublue-os/bluefin", "ghcr.io/ublue-os/bluefin-dx"],
      "pinDigests": false
    },
    {
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
  ]
}
